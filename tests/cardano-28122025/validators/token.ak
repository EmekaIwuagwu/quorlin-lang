/// View function: balance_of
fn balance_of(datum: TokenDatum, owner: VerificationKeyHash) -> Int {
    list.find(d.balances, fn(pair) { pair.1st == owner })
}

/// View function: allowance
fn allowance(datum: TokenDatum, owner: VerificationKeyHash, spender: VerificationKeyHash) -> Int {
